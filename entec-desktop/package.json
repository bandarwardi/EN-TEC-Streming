{
  "name": "entec-desktop",
  "version": "1.0.0",
  "description": "ENTEC Streaming Application",
  "main": "main.js",
  "author": "ENTEC",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win"
  },
  "build": {
    "appId": "com.entec.streaming",
    "productName": "ENTEC Streaming",
    "asarUnpack": [
      "app/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "app/icon.ico"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.7"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2"
  }
}
